# AMD ROCm override for APUs (e.g. Strix Halo) and discrete AMDGPU cards.
#
# Usage:
#   cp docker-compose.rocm.yml.example docker-compose.rocm.yml
#   docker compose -f docker-compose.yml -f docker-compose.rocm.yml up -d
#
# For APUs (integrated graphics), the same /dev/kfd + /dev/dri path works.
# Set HSA_OVERRIDE_GFX_VERSION to match your hardware:
#   - RDNA2 (RX 6000):  10.3.0
#   - RDNA3 (RX 7000):  11.0.0
#   - Strix Halo iGPU:  11.5.1
#
# Install the ROCm ORT wheel inside the container, or use Dockerfile.rocm.

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.rocm
    devices:
      - /dev/kfd
      - /dev/dri
    group_add:
      - video
      - render
    environment:
      - HSA_OVERRIDE_GFX_VERSION=${HSA_OVERRIDE_GFX_VERSION:-10.3.0}
      - HIP_VISIBLE_DEVICES=${HIP_VISIBLE_DEVICES:-0}
      - ONNX_PROVIDER=${ONNX_PROVIDER:-auto}
      - TORCH_DEVICE=${TORCH_DEVICE:-cuda}
    # iommu=pt may be needed for some APU configurations
    # security_opt:
    #   - seccomp:unconfined
