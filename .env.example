# Copy to .env for *isolated* local development. Never commit .env.
# Leaving API_KEY empty or placeholder fails closed until a secure value is provided.
API_KEY=
REQUIRE_API_KEY=true
DEFAULT_VOICE=af_bella
PORT=9090
HOST=0.0.0.0
# The three paths/provider below are the Docker (container) values and are already
# pinned in docker-compose.yml; docker compose does not read them from .env.
# For a bare-metal run (python -m openai_kokoro_tts.server) use host paths instead, e.g.
#   ONNX_MODEL_PATH=models/kokoro/kokoro-v0_19.onnx
#   VOICES_PATH=models/kokoro/voices.json
# Files come from ./setup_models.sh (see MODELS.md).
ONNX_MODEL_PATH=/app/models/kokoro/kokoro-v0_19.onnx
VOICES_PATH=/app/models/kokoro/voices.json
# auto | cpu | cuda | dml | rocm | migraphx (unset == auto; CPU is always the fallback)
ONNX_PROVIDER=CPUExecutionProvider
